@{
    ViewData["Title"] = "Panel de Control";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-panel.css" asp-append-version="true" />
}

<div class="admin-container">
    <br><br><br>
    
    <aside class="sidebar">
        <p id="menu-titulo" class="text-muted small fw-bold mb-4 px-2 d-none d-lg-block">MENÚ ADMINISTRADOR</p>
        <nav>
            <a onclick="cambiarSeccion('vehiculos')" id="btn-nav-vehiculos" class="nav-admin-link solo-admin active">
                <i class="bi bi-car-front"></i> Vehículos
            </a>
            <a onclick="cambiarSeccion('usuarios')" id="btn-nav-usuarios" class="nav-admin-link solo-admin">
                <i class="bi bi-people"></i> Usuarios
            </a>
            <a onclick="cambiarSeccion('vendedores')" id="btn-nav-vendedores" class="nav-admin-link solo-admin">
                <i class="bi bi-person-badge"></i> Vendedores
            </a>
            <a href="/Admin/Consultas" class="nav-admin-link">
                <i class="bi bi-envelope"></i>
                Mensajes
                <span id="badgeMensajes" class="badge bg-danger ms-2" style="display:none;"></span>
            </a>
            <a onclick="cambiarSeccion('ajustes')" id="btn-nav-ajustes" class="nav-admin-link solo-admin">
                <i class="bi bi-gear"></i> Ajustes
            </a>
            <hr class="border-secondary">
            <a href="/" class="nav-admin-link text-info"><i class="bi bi-arrow-left-circle"></i> Web</a>
        </nav>
    </aside>

    <main class="main-content">
        <div class="container-fluid">
            
            <partial name="_VehiculosSection" />

            <partial name="_UsuariosModalYTabla" />

            <partial name="_VendedoresSection" />

            <partial name="_AjustesSection" />

            <div id="seccion-vendedor-home" style="display: none;" class="text-center p-5 bg-black rounded border border-secondary mt-4">
                <i class="bi bi-envelope-open text-danger" style="font-size: 4rem;"></i>
                <h3 class="text-white mt-3 fw-bold">MÓDULO DE ATENCIÓN</h3>
                <p class="text-muted">Tu perfil de acceso está asignado a la gestión de consultas de clientes.</p>
                <a href="/Admin/Consultas" class="btn btn-danger btn-sm px-4 fw-bold mt-2">
                    <i class="bi bi-envelope"></i> IR A MIS MENSAJES
                </a>
            </div>

        </div>
    </main>
</div>

@section Scripts {
    <script>
        const token = localStorage.getItem('jonel_token');
        const modalUsuario = document.getElementById('modalUsuario') ? new bootstrap.Modal(document.getElementById('modalUsuario')) : null;
        let usuarioRol = "Vendedor"; // Por defecto asumimos vendedor por seguridad

        // Función auxiliar para decodificar el payload del JWT de forma segura en JS
        function obtenerRolDesdeToken(tokenJWT) {
            try {
                if (!tokenJWT) return "Vendedor";
                const base64Url = tokenJWT.split('.')[1];
                const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
                const jsonPayload = decodeURIComponent(window.atob(base64).split('').map(function(c) {
                    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
                }).join(''));

                const payload = JSON.parse(jsonPayload);
                
                // Mapeos típicos de roles en JWT (Claim estándar o personalizado)
                return payload.role || payload["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] || "Vendedor";
            } catch (error) {
                console.error("Error al decodificar el rol del token:", error);
                return "Vendedor";
            }
        }

        document.addEventListener("DOMContentLoaded", () => {
            if (!token) {
                window.location.href = '/Home/Acceso';
                return;
            }

            // 1. Validar el rol del usuario actual
            usuarioRol = obtenerRolDesdeToken(token);

            // 2. Aplicar restricciones de interfaz en base al rol
            if (usuarioRol === "Vendedor" || usuarioRol === "vendedor") {
                // Ocultar todos los botones de navegación administrativa del Sidebar
                document.querySelectorAll('.solo-admin').forEach(el => el.style.setProperty('display', 'none', 'important'));
                
                // Cambiar títulos informativos
                const menuTxt = document.getElementById('menu-titulo');
                if (menuTxt) menuTxt.innerText = "MENÚ VENDEDOR";

                // Forzar redirección directa a la sección de consultas
                window.location.href = '/Admin/Consultas';
                return; 
            }

            // Si es Administrador, el flujo continúa normal como antes
            cargarPendientes();

            if (typeof listar === 'function') listar();
            cambiarSeccion('vehiculos');
        });

        async function cargarPendientes() {
            try {
                const resp = await fetch('/Admin/GetConsultas', {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                if (!resp.ok) return;

                const consultas = await resp.json();
                const pendientes = consultas.filter(c => c.estado === "Pendiente").length;
                const badge = document.getElementById('badgeMensajes');

                if (pendientes > 0 && badge) {
                    badge.style.display = 'inline-block';
                    badge.innerText = pendientes;
                }
            } catch (e) {
                console.error(e);
            }
        }

        function cambiarSeccion(seccion) {
            // Protección extra: Si un vendedor burla el click e intenta ejecutar cambiarSeccion por consola
            if (usuarioRol === "Vendedor" || usuarioRol === "vendedor") {
                window.location.href = '/Admin/Consultas';
                return;
            }

            const secVehiculos = document.getElementById('seccion-vehiculos');
            const secUsuarios = document.getElementById('seccion-usuarios'); 
            const secVendedores = document.getElementById('seccion-vendedores'); 
            const secAjustes = document.getElementById('seccion-ajustes');

            const btnVehiculos = document.getElementById('btn-nav-vehiculos');
            const btnUsuarios = document.getElementById('btn-nav-usuarios');
            const btnVendedores = document.getElementById('btn-nav-vendedores'); 
            const btnAjustes = document.getElementById('btn-nav-ajustes');

            // Resetear visibilidad
            if(secVehiculos) secVehiculos.style.display = 'none';
            if(secUsuarios) secUsuarios.style.display = 'none';
            if(secVendedores) secVendedores.style.display = 'none'; 
            if(secAjustes) secAjustes.style.display = 'none';

            btnVehiculos?.classList.remove('active');
            btnUsuarios?.classList.remove('active');
            btnVendedores?.classList.remove('active'); 
            btnAjustes?.classList.remove('active');

            // Activar sección seleccionada
            if (seccion === 'vehiculos' && secVehiculos) {
                secVehiculos.style.display = 'block';
                btnVehiculos.classList.add('active');
            } else if (seccion === 'usuarios' && secUsuarios) {
                secUsuarios.style.display = 'block';
                btnUsuarios.classList.add('active');
                
                if (typeof listarUsuarios === 'function') listarUsuarios();
                else if (typeof cargarUsuarios === 'function') cargarUsuarios();
                else if (typeof getUsuarios === 'function') getUsuarios();
            } else if (seccion === 'vendedores' && secVendedores) {
                secVendedores.style.display = 'block';
                btnVendedores.classList.add('active');
                
                if (typeof listarVendedores === 'function') listarVendedores();
                else if (typeof cargarVendedores === 'function') cargarVendedores();
            } else if (seccion === 'ajustes' && secAjustes) {
                secAjustes.style.display = 'block';
                btnAjustes.classList.add('active');
            }
        }
    </script>
    
    <script src="~/js/admin-vehiculos.js" asp-append-version="true"></script>
    <script src="~/js/admin-vendedores.js" asp-append-version="true"></script>
}