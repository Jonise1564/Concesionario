@*
@{
    ViewData["Title"] = "Consultas";
}

<style>
    body {
        background: #000;
        color: white;
    }

    .consultas-container {
        padding: 120px 40px;
        margin-top: 100px;
    }

    .table-dark {
        background: #111 !important;
        margin-bottom: 300px;
    }

    .badge-pendiente {
        background: orange;
        color: black;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: bold;
    }

    .badge-respondido {
        background: #198754;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: bold;
    }

    .text-interes {
        color: #ff3333; /* Rojo Jonel */
        font-weight: bold;
    }

    /* Estilo sutil para diferenciar el texto de la respuesta del administrador */
    .text-respuesta-admin {
        color: #a0a0a0;
        font-style: italic;
        font-size: 0.95rem;
    }
</style>

<div class="consultas-container">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-uppercase">
            Consultas de Clientes
        </h2>

        <a href="/Admin/Index" class="btn btn-outline-light">
            Volver
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Interés / Vehículo</th>
                    <th>Mensaje</th>
                    <th>Respuesta</th> <th>Fecha</th>
                    <th>Estado</th>
                    <th>Acción</th>
                </tr>
            </thead>

            <tbody id="tablaConsultas"></tbody>
        </table>
    </div>

</div>

<div class="modal fade" id="modalRespuesta" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-white border-secondary">

            <div class="modal-header border-secondary">
                <h5 class="modal-title">Responder Consulta</h5>
                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">
                <div class="mb-3 p-2 bg-black border border-secondary rounded">
                    <p class="mb-1 text-muted small">Interés del Cliente:</p>
                    <h6 id="modalInteresInfo" class="text-interes mb-0">-</h6>
                </div>

                <input type="hidden" id="consultaId">

                <div class="mb-2">
                    <label class="form-label small text-muted">Escribí o modificá la respuesta:</label>
                    <textarea id="respuestaAdmin"
                              class="form-control bg-black text-white border-secondary"
                              rows="5"
                              placeholder="Escribí la respuesta..."></textarea>
                </div>
            </div>

            <div class="modal-footer border-secondary">
                <button class="btn btn-outline-light"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button class="btn btn-danger"
                        onclick="guardarRespuesta()">
                    Guardar respuesta
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {

<script>
    const token = localStorage.getItem('jonel_token');
    const modal = new bootstrap.Modal(document.getElementById('modalRespuesta'));

let consultasLocales = [];

    async function cargarConsultas() {
        try {
            const res = await fetch('/Admin/GetConsultas', {
                headers: {
                    'Authorization': `Bearer ${token}`
                }
            });

            const data = await res.json();
            consultasLocales = data;

            const tabla = document.getElementById('tablaConsultas');

            tabla.innerHTML = data.map(c => `
                <tr>
                    <td>${c.nombre}</td>
                    <td>${c.email}</td>
                    <td>${c.telefono}</td>
                    <td class="text-interes">${c.interes || 'General / No especifica'}</td>
                    <td style="max-width:200px;">${c.mensaje}</td>

<td style="max-width:200px;" class="text-respuesta-admin">
                        ${c.respuestaAdmin ? c.respuestaAdmin : '<span class="text-muted small">Sin responder aún</span>'}
                    </td>

                    <td>${new Date(c.fecha).toLocaleDateString()}</td>
                    <td>
                        ${
                            c.estado === "Pendiente"
                            ? '<span class="badge-pendiente">Pendiente</span>'
                            : '<span class="badge-respondido">Respondido</span>'
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-danger" onclick="abrirModal(${c.id})">
                            ${c.respuestaAdmin ? 'Editar Resp.' : 'Responder'}
                        </button>
                    </td>
                </tr>
            `).join('');
        } catch (error) {
            console.error("Error al cargar consultas:", error);
        }
    }

    function abrirModal(id) {
        document.getElementById('consultaId').value = id;

        // Buscamos la consulta seleccionada en nuestra lista en memoria
        const consultaSeleccionada = consultasLocales.find(c => c.id === id);
        if (consultaSeleccionada) {
            document.getElementById('modalInteresInfo').innerText = consultaSeleccionada.interes || 'General / No especifica';

// 🆕 Si ya tenía una respuesta guardada antes, la cargamos en el textarea para que la pueda ver/editar
            document.getElementById('respuestaAdmin').value = consultaSeleccionada.respuestaAdmin || "";
        } else {
            document.getElementById('respuestaAdmin').value = "";
        }

        modal.show();
    }

    async function guardarRespuesta() {
        const id = document.getElementById('consultaId').value;
        const respuesta = document.getElementById('respuestaAdmin').value;

        const formData = new FormData();
        formData.append("id", id);
        formData.append("respuesta", respuesta);

        const res = await fetch('/Admin/ResponderConsulta', {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${token}`
            },
            body: formData
        });

        if (res.ok) {
            modal.hide();
            cargarConsultas();
            alert("Respuesta guardada ✅");
        }
    }

    cargarConsultas();
</script>

} *@


@{
    ViewData["Title"] = "Consultas";
}

<style>
    body {
        background: #000;
        color: white;
    }

    .consultas-container {
        margin-top: 75px;
    }

    .table-dark {
        background: #111 !important;
        margin-bottom: 100px;
    }

    .badge-pendiente {
        background: orange;
        color: black;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: bold;
        display: inline-block;
    }

    .badge-respondido {
        background: #198754;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: bold;
        display: inline-block;
    }

    .text-interes {
        color: #ff3333;
        /* Rojo Jonel */
        font-weight: bold;
    }

    .text-respuesta-admin {
        color: #a0a0a0;
        font-style: italic;
        font-size: 0.95rem;
    }

    /* ==========================================================
        📱 DE TABLA A CARDS EN PANTALLAS CHICAS
       ========================================================== */
    @@media (max-width: 767.98px) {

        .table-responsive-cards table,
        .table-responsive-cards thead,
        .table-responsive-cards tbody,
        .table-responsive-cards th,
        .table-responsive-cards td,
        .table-responsive-cards tr {
            display: block;
        }

        .table-responsive-cards thead tr {
            position: absolute;
            top: -9999px;
            left: -9999px;
        }

        .table-responsive-cards tr {
            border: 1px solid #333;
            margin-bottom: 15px;
            background: #0b0b0b;
            padding: 10px;
            border-radius: 8px;
        }

        .table-responsive-cards td {
            border: none;
            border-bottom: 1px solid #222;
            position: relative;
            padding-left: 45% !important;
            text-align: right !important;
            white-space: normal;
            min-height: 40px;
        }

        .table-responsive-cards td:last-child {
            border-bottom: none;
            text-align: center !important;
            padding-left: 12px !important;
            padding-top: 15px;
        }

        .table-responsive-cards td:before {
            position: absolute;
            top: 50%;
            left: 12px;
            transform: translateY(-50%);
            width: 40%;
            padding-right: 10px;
            white-space: nowrap;
            text-align: left;
            font-weight: bold;
            color: #888;
            font-size: 0.8rem;
            text-transform: uppercase;
        }

        /* Forzamos sincronización exacta con las columnas */
        .table-responsive-cards td:nth-of-type(1):before {
            content: "Cliente";
        }

        .table-responsive-cards td:nth-of-type(2):before {
            content: "Email";
        }

        .table-responsive-cards td:nth-of-type(3):before {
            content: "Teléfono";
        }

        .table-responsive-cards td:nth-of-type(4):before {
            content: "Vehículo";
        }

        .table-responsive-cards td:nth-of-type(5):before {
            content: "Mensaje";
        }

        .table-responsive-cards td:nth-of-type(6):before {
            content: "Respuesta";
        }

        .table-responsive-cards td:nth-of-type(7):before {
            content: "Fecha";
        }

        .table-responsive-cards td:nth-of-type(8):before {
            content: "Estado";
        }
    }

    /* Custom color para el texto del placeholder */
    .input-group .form-control::placeholder {
        color: #a0a0a0 !important;
        /* Gris claro con buen contraste */
        font-size: 0.9rem;
        /* Un toque más chico para que no se corte en celulares */
        opacity: 0.8;
    }

    /* Opcional: Asegurar que el icono de la lupa también mantenga buen contraste */
    .input-group-text.text-muted {
        color: #a0a0a0 !important;
    }

    /* Efecto de enfoque (focus) para que la barra resalte al hacer clic */
    .form-control:focus {
        border-color: #ff3333 !important;
        /* Rojo Jonel al clickear */
        box-shadow: 0 0 0 0.25rem rgba(255, 51, 51, 0.25) !important;
        background-color: #050505 !important;
        color: white !important;
    }
</style>

<div class="container-fluid consultas-container pt-5 px-2 px-md-5">

    <div
        class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
        <h2 class="fw-bold text-uppercase m-0 fs-3 fs-md-2">
            Consultas de Clientes
        </h2>

        <a href="/Admin/Index" class="btn btn-sm btn-outline-light px-4 w-100 w-sm-auto">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <!-- BARRA DE BÚSQUEDA Y FILTRO DE ESTADO -->
    <div class="row g-2 mb-4">
        <div class="col-12 col-md-8">
            <div class="input-group">
                <span class="input-group-text bg-black border-secondary text-muted"><i class="bi bi-search"></i></span>
                <input type="text" id="buscarConsulta" class="form-control bg-black border-secondary text-white"
                       placeholder="Buscar por cliente, email, vehículo o contenido del mensaje..."
                       oninput="filtrarConsultas()">
            </div>
        </div>
        <div class="col-12 col-md-4">
            <select id="filtrarEstadoConsulta" class="form-select bg-black border-secondary text-white"
                    onchange="filtrarConsultas()">
                <option value="todos" selected>Todos los estados</option>
                <option value="Pendiente">Pendientes</option>
                <option value="Respondido">Respondidos</option>
            </select>
        </div>
    </div>

    <div class="table-responsive-cards">
        <table class="table table-dark table-hover align-middle">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Interés / Vehículo</th>
                    <th>Mensaje</th>
                    <th>Respuesta</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th>Acción</th>
                </tr>
            </thead>

            <tbody id="tablaConsultas">
                <tr>
                    <td colspan="9" class="text-center p-5">
                        <div class="spinner-border text-danger" role="status"></div>
                        <p class="mt-2 text-muted small">Cargando mensajes...</p>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

</div>

<!-- Modal de Respuestas -->
<div class="modal fade" id="modalRespuesta" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">

            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold">RESPONDER CONSULTA</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="mb-3 p-3 rounded" style="background: #151515; border: 1px solid #2d2d2d;">
                    <p class="mb-1 small fw-bold text-uppercase" style="color: #b0b0b0; letter-spacing: 0.5px;">
                        Interés del Cliente:
                    </p>
                    <h6 id="modalInteresInfo" class="text-interes mb-0 fs-5">-</h6>
                </div>

                <input type="hidden" id="consultaId">

                <div class="mb-2">
                    <label class="form-label small fw-bold text-uppercase" style="color: #b0b0b0;">Escribí o modificá la
                        respuesta:</label>
                        <textarea id="respuestaAdmin" class="form-control bg-black text-white border-secondary" rows="5"
                                  placeholder="Escribí la respuesta..."></textarea>
                    </div>
                </div>

                <div class="modal-footer border-secondary">
                    <button class="btn btn-sm btn-outline-light" data-bs-dismiss="modal">Cancelar</button>
                    <button class="btn btn-sm btn-danger fw-bold px-3" onclick="guardarRespuesta()">Guardar
                        respuesta</button>
                    </div>

                </div>
            </div>
        </div>

        @section Scripts {
            <script>
                const token = localStorage.getItem('jonel_token');
                const modal = new bootstrap.Modal(document.getElementById('modalRespuesta'));

                let consultasLocales = [];

                async function cargarConsultas() {
                    try {
                        const res = await fetch('/Admin/GetConsultas', {
                            headers: {
                                'Authorization': `Bearer ${token}`
                            }
                        });

                        if (!res.ok) throw new Error("Status: " + res.status);

                        const data = await res.json();

                        //ORDENAR: Forzamos el orden cronológico descendente por fecha (más reciente primero)
                        consultasLocales = data.sort((a, b) => new Date(b.fecha) - new Date(a.fecha));

                        // Renderizado completo sin filtros iniciales
                        inyectarTablaConsultas(consultasLocales);

                    } catch (error) {
                        console.error("Error al cargar consultas:", error);
                        document.getElementById('tablaConsultas').innerHTML = `<tr><td colspan="9" class="text-center text-danger p-4">Error de conexión</td></tr>`;
                    }
                }

                function inyectarTablaConsultas(lista) {
                    const tabla = document.getElementById('tablaConsultas');

                    if (!lista || lista.length === 0) {
                        tabla.innerHTML = '<tr><td colspan="9" class="text-center text-muted p-4">No se encontraron consultas</td></tr>';
                        return;
                    }

                    tabla.innerHTML = lista.map(c => {
                        // Normalizar estado para evitar fallos de mayúsculas/minúsculas del backend
                        const estadoNormalizado = c.estado ? c.estado.toString().trim() : "Pendiente";
                        const esPendiente = estadoNormalizado.toLowerCase() === "pendiente";

                        return `
                            <tr>
                                <td>${c.nombre || ''}</td>
                                <td>${c.email || ''}</td>
                                <td>${c.telefono || ''}</td>
                                <td class="text-interes">${c.interes || 'General / No especifica'}</td>
                                <td style="max-width:250px; white-space: normal;">${c.mensaje || ''}</td>
                    
                                <td style="max-width:250px; white-space: normal;" class="text-respuesta-admin">
                                    ${c.respuestaAdmin ? c.respuestaAdmin : '<span class="text-muted small">Sin responder aún</span>'}
                                </td>

                                <td>${new Date(c.fecha).toLocaleDateString()}</td>
                                <td>
                                    ${esPendiente
                                ? '<span class="badge-pendiente">Pendiente</span>'
                                : '<span class="badge-respondido">Respondido</span>'
                            }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-danger w-100 w-md-auto fw-bold" onclick="abrirModal(${c.id})">
                                        ${c.respuestaAdmin ? 'Editar Resp.' : 'Responder'}
                                    </button>
                                </td>
                            </tr>
                        `;
                    }).join('');
                }

                function filtrarConsultas() {
                    const busqueda = document.getElementById('buscarConsulta').value.toLowerCase().trim();
                    const estadoFiltro = document.getElementById('filtrarEstadoConsulta').value.toLowerCase();

                    const resultado = consultasLocales.filter(c => {
                        const nombre = (c.nombre || "").toLowerCase();
                        const email = (c.email || "").toLowerCase();
                        const interes = (c.interes || "").toLowerCase();
                        const mensaje = (c.mensaje || "").toLowerCase();
                        const estadoObj = (c.estado || "Pendiente").toLowerCase().trim();

                        // 1. Macheo de caracteres
                        const cumpleTexto =
                            nombre.includes(busqueda) ||
                            email.includes(busqueda) ||
                            interes.includes(busqueda) ||
                            mensaje.includes(busqueda);

                        // 2. Macheo estricto del combobox desensibilizado
                        const cumpleEstado = (estadoFiltro === 'todos') || (estadoObj === estadoFiltro);

                        return cumpleTexto && cumpleEstado;
                    });

                    inyectarTablaConsultas(resultado);
                }

                function abrirModal(id) {
                    document.getElementById('consultaId').value = id;
                    const consultaSeleccionada = consultasLocales.find(c => c.id === id);
                    if (consultaSeleccionada) {
                        document.getElementById('modalInteresInfo').innerText = consultaSeleccionada.interes || 'General / No especifica';
                        document.getElementById('respuestaAdmin').value = consultaSeleccionada.respuestaAdmin || "";
                    } else {
                        document.getElementById('respuestaAdmin').value = "";
                    }
                    modal.show();
                }

                async function guardarRespuesta() {
                    const id = document.getElementById('consultaId').value;
                    const respuesta = document.getElementById('respuestaAdmin').value;

                    const formData = new FormData();
                    formData.append("id", id);
                    formData.append("respuesta", respuesta);

                    const res = await fetch('/Admin/ResponderConsulta', {
                        method: 'POST',
                        headers: { 'Authorization': `Bearer ${token}` },
                        body: formData
                    });

                    if (res.ok) {
                        modal.hide();
                        cargarConsultas();
                        alert("Respuesta guardada ✅");
                    }
                }

                cargarConsultas();
            </script>
        }