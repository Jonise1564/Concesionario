<!-- Views/Admin/_UsuariosModalYTabla.cshtml -->

<!-- SECCIÓN USUARIOS -->
<div id="seccion-usuarios" style="display: none;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-800 text-uppercase text-white">Gestión de <span class="text-danger">Usuarios</span></h2>
        <button class="btn btn-danger btn-sm px-4 fw-bold" onclick="abrirModalUsuario()">
            <i class="bi bi-person-plus"></i> NUEVO USUARIO
        </button>
    </div>
    <div class="table-responsive">
        <table class="table table-dark table-hover border-secondary align-middle">
            <thead class="text-muted small">
                <tr>
                    <th>ID</th>
                    <th>NOMBRE DE USUARIO</th>
                    <th>ROL</th>
                    <th>ACCIONES</th>
                </tr>
            </thead>
            <tbody id="tablaUsuariosCuerpo">
                <tr>
                    <td colspan="4" class="text-center p-4">
                        <div class="spinner-border text-danger" role="status"></div>
                        <p class="mt-2 text-muted mb-0">Cargando usuarios...</p>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalUsuario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold text-white" id="modalUsuarioTitulo">DATOS DEL USUARIO</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-white">
                <form id="formUsuario">
                    <input type="hidden" id="uId" name="Id" value="0">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-danger text-uppercase">Nombre de Usuario</label>
                        <input type="text" id="uNombreUsuario" name="NombreUsuario" class="form-control bg-black border-secondary text-white" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-danger text-uppercase">Contraseña</label>
                        <input type="password" id="uPassword" name="Password" class="form-control bg-black border-secondary text-white" placeholder="Escriba la contraseña">
                        <small class="text-muted d-block mt-1" id="passHelp" style="display:none;">Si editas el usuario, rellena este campo solo si quieres cambiar la clave.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-danger text-uppercase">Rol / Permisos</label>
                        <select id="uRol" name="Rol" class="form-select bg-black border-secondary text-white">
                            <option value="Vendedor">Vendedor</option>
                            <option value="Admin">Administrador</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-outline-light btn-sm" data-bs-dismiss="modal">CANCELAR</button>
                <button type="button" class="btn btn-danger btn-sm px-4 fw-bold" onclick="guardarUsuario()">GUARDAR USUARIO</button>
            </div>
        </div>
    </div>
</div>

<script>
    // Se asume que la variable 'token' ya fue declarada globalmente en la vista principal (Index)
    
    // --- FUNCIÓN PARA LISTAR USUARIOS ---
    async function listarUsuarios() {
        try {
            const cuerpo = document.getElementById('tablaUsuariosCuerpo');
            
            const resp = await fetch('/Admin/GetUsuarios', {
                method: 'GET',
                headers: { 'Authorization': `Bearer ${token}` }
            });

            if (resp.status === 401) {
                window.location.href = '/Home/Acceso';
                return;
            }

            if (!resp.ok) throw new Error("Error al traer usuarios");

            const usuarios = await resp.json();

            if (usuarios.length === 0) {
                cuerpo.innerHTML = '<tr><td colspan="4" class="text-center text-muted p-4">No hay usuarios registrados</td></tr>';
                return;
            }

            cuerpo.innerHTML = usuarios.map(u => {
                // Escapamos el objeto a string JSON seguro para pasar por parámetro en el onclick
                const usuarioJson = JSON.stringify(u).replace(/'/g, "&apos;");
                
                return `
                    <tr class="align-middle">
                        <td class="text-muted">${u.id}</td>
                        <td class="fw-bold text-white">${u.nombreUsuario}</td>
                        <td>
                            <span class="badge ${u.rol === 'Admin' ? 'bg-danger' : 'bg-secondary'}">
                                ${u.rol}
                            </span>
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-light me-2" onclick='editarUsuario(${usuarioJson})'>
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" onclick="eliminarUsuario(${u.id})">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');

        } catch (err) {
            console.error("Error en listarUsuarios:", err);
            document.getElementById('tablaUsuariosCuerpo').innerHTML = 
                `<tr><td colspan="4" class="text-center text-danger">Error de conexión al cargar usuarios.</td></tr>`;
        }
    }

    // --- ABRIR MODAL PARA NUEVO USUARIO ---
    function abrirModalUsuario() {
        document.getElementById('modalUsuarioTitulo').innerText = "NUEVO USUARIO";
        document.getElementById('formUsuario').reset();
        document.getElementById('uId').value = "0";
        document.getElementById('uPassword').placeholder = "Escriba la contraseña";
        document.getElementById('uPassword').required = true; // Obligatorio si es nuevo
        document.getElementById('passHelp').style.display = 'none';
        
        modalUsuario.show();
    }

    // --- ABRIR MODAL PARA EDITAR ---
    function editarUsuario(u) {
        document.getElementById('modalUsuarioTitulo').innerText = "MODIFICAR USUARIO";
        document.getElementById('uId').value = u.id;
        document.getElementById('uNombreUsuario').value = u.nombreUsuario;
        document.getElementById('uRol').value = u.rol;
        
        document.getElementById('uPassword').value = "";
        document.getElementById('uPassword').placeholder = "Dejar en blanco para no modificar";
        document.getElementById('uPassword').required = false; // Opcional si edita
        document.getElementById('passHelp').style.display = 'block';

        modalUsuario.show();
    }

    // --- GUARDAR (CREAR O EDITAR) ---
    async function guardarUsuario() {
        const form = document.getElementById('formUsuario');
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        const id = document.getElementById('uId').value;
        const nombreUsuario = document.getElementById('uNombreUsuario').value;
        const password = document.getElementById('uPassword').value;
        const rol = document.getElementById('uRol').value;

        // Armamos el payload simulando la estructura del backend de tu endpoint anterior
        const usuarioData = {
            Id: parseInt(id),
            NombreUsuario: nombreUsuario,
            Rol: rol
        };

        // Solo mandamos el Password si escribieron algo (útil para la edición)
        if (password.trim() !== "") {
            usuarioData.Password = password;
        }

        try {
            // Nota: Cambiá '/Admin/GuardarUsuario' por la ruta exacta de tu método POST en el controlador
            const response = await fetch('/Admin/GuardarUsuario', {
                method: 'POST',
                headers: { 
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(usuarioData)
            });

            if (response.ok) {
                modalUsuario.hide();
                listarUsuarios();
            } else {
                const error = await response.json();
                alert("Error: " + (error.message || "No se pudo procesar el usuario."));
            }
        } catch (err) {
            console.error(err);
            alert("Error de red al intentar guardar el usuario.");
        }
    }

    // --- ELIMINAR USUARIO ---
    async function eliminarUsuario(id) {
        if (confirm("¿Estás seguro de que deseas eliminar definitivamente a este usuario?")) {
            try {
                // Nota: Cambiá '/Admin/EliminarUsuario' por tu endpoint de backend real
                const resp = await fetch(`/Admin/EliminarUsuario?id=${id}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': `Bearer ${token}` }
                });

                if (resp.ok) {
                    listarUsuarios();
                } else {
                    alert("No se pudo eliminar el usuario.");
                }
            } catch (err) {
                console.error(err);
                alert("Error de conexión al eliminar.");
            }
        }
    }
</script>