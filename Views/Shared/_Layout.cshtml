    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Lógica de autenticación y roles existente
        document.addEventListener("DOMContentLoaded", function() {
            const token = localStorage.getItem('jonel_token');
            const menuAcceso = document.getElementById('menuAcceso');
            const menuAdmin = document.getElementById('menuAdmin');
            const menuLogout = document.getElementById('menuLogout');

            if (token) {
                if(menuAcceso) menuAcceso.style.display = 'none';
                if(menuLogout) menuLogout.style.display = 'block';

                try {
                    const base64Url = token.split('.')[1];
                    const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
                    const payload = JSON.parse(window.atob(base64));

                    const rol = payload["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] || payload["role"] || payload["Rol"];

                    if (rol && (rol.toLowerCase() === 'admin')) {
                        if(menuAdmin) menuAdmin.style.display = 'block';
                    } else {
                        if(menuAdmin) menuAdmin.style.display = 'none';
                    }
                } catch (error) {
                    console.error("Error al verificar el rol del token:", error);
                    if(menuAdmin) menuAdmin.style.display = 'none';
                }
            }

            // Inicializar el ícono correcto del botón al cargar el DOM
            actualizarIconoTema(document.documentElement.getAttribute('data-bs-theme'));
        });

        function cerrarSesion() {
            localStorage.removeItem('jonel_token');
            localStorage.removeItem('jonel_user');
            window.location.href = '/Home/Index';
        }

        // NUEVAS FUNCIÓNES PARA LA GESTIÓN DE TEMAS VISUALES
        function conmutarTema() {
            const htmlEl = document.documentElement;
            const temaActual = htmlEl.getAttribute('data-bs-theme');
            const nuevoTema = temaActual === 'dark' ? 'light' : 'dark';
            
            htmlEl.setAttribute('data-bs-theme', nuevoTema);
            localStorage.setItem('theme', nuevoTema);
            actualizarIconoTema(nuevoTema);
        }

        function actualizarIconoTema(tema) {
            const icono = document.getElementById('themeIcon');
            if (!icono) return;
            
            if (tema === 'dark') {
                icono.className = 'bi bi-moon-stars-fill fs-5';
            } else {
                icono.className = 'bi bi-sun-fill fs-5 text-warning';
            }
        }
    </script>

