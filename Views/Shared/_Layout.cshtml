    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const token = localStorage.getItem('jonel_token');
            const menuAcceso = document.getElementById('menuAcceso');
            const menuAdmin = document.getElementById('menuAdmin');
            const menuLogout = document.getElementById('menuLogout');

            if (token) {
                if(menuAcceso) menuAcceso.style.display = 'none';
                if(menuLogout) menuLogout.style.display = 'block';

                // Decodificamos el JWT para revisar los Claims de rol de .NET
                try {
                    const base64Url = token.split('.')[1];
                    const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
                    const payload = JSON.parse(window.atob(base64));

                    // Buscamos los formatos típicos de claims que genera .NET para los roles
                    const rol = payload["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] || payload["role"] || payload["Rol"];

                    // SI Y SOLO SI es admin, habilitamos la visualización del botón
                    if (rol && (rol.toLowerCase() === 'admin')) {
                        if(menuAdmin) menuAdmin.style.display = 'block';
                    } else {
                        if(menuAdmin) menuAdmin.style.display = 'none';
                    }
                } catch (error) {
                    console.error("Error al verificar el rol del token:", error);
                    if(menuAdmin) menuAdmin.style.display = 'none';
                }
            }
        });

        function cerrarSesion() {
            localStorage.removeItem('jonel_token');
            localStorage.removeItem('jonel_user');
            window.location.href = '/Home/Index';
        }
    </script>

